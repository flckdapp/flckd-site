{
  "name": "flckd-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun scripts/prepare-assets.mjs && astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "bun scripts/prepare-assets.mjs && astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "assets:prepare": "bun scripts/prepare-assets.mjs",
    "qa:verify": "bun scripts/verify.mjs",
    "qa:lighthouse": "bun scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "lighthouse": "^13.4.1",
    "typescript": "^6"
  }
}
